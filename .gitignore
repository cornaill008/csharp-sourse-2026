# This directory is the user's home folder, shared with many unrelated tools
# (SSH keys, other agent configs, etc). Track ONLY the Unity project here.
/*

!/Assets
!/Assets/**
!/Packages
!/Packages/**
!/ProjectSettings
!/ProjectSettings/**
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CLAUDE.md
!/Docs
!/Docs/**

# Unity-generated / local-only content inside the tracked project
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Rr]ecordings/
[Uu]serSettings/
[Aa]uto[Bb]uild/
.vs/
.vsconfig
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app
*.ipa

# Secrets — never commit API keys/tokens
*.local.json
*secret*
*Secret*
.env
.env.*
